# -----------------------------------------------------------------------------
#  eesti-rollerirent — keskkonnamuutujad
#  Kopeeri see fail nimega .env ja kohanda vajadusel.
#  Bun laeb .env automaatselt (bun run seed.ts).
# -----------------------------------------------------------------------------

# Andmebaasi ühendus (kasutaja:parool@host:port/andmebaas)
DATABASE_URL=postgres://rollerirent:rollerirent@localhost:5432/rollerirent

# Juhuarvude seeme. Sama seeme -> bait-baidilt sama andmebaas.
SEEME=20260920

# Mastaabitegur. 1 = täismaht (2,6 mln sõitu). 0.01 = kiire proovikäivitus.
MASTAAP=1

# Paralleelsete andmebaasiühenduste arv mass-sisestusel (soovitus: CPU tuumade arv)
PARALLEELSUS=4

# Ühes COPY-partiis genereeritavate id-de arv
PARTII=25000

# Ridade arv tabelite kaupa (korrutatakse mastaabiteguriga)
KASUTAJAID=400000
ROLLEREID=60000
SOITE=2600000
HOOLDUSI=240000
TUGIPILETEID=95000
